+
+import { useEffect } from 'react'
+import { useSnapshot } from 'valtio'
+
+import {
+  getStoredChatSidebarWidth,
+  setChatSidebarWidthCssVar,
+} from '@/pages/chat/components/ChatSidebar/chatSidebarWidth'
+import { userStore } from '@/store/user'
+
+// Sets --chat-sidebar-width on the document root at app startup so pages
+// other than /chat (e.g. Gradient, SidebarToggle offset) render a correct
+// offset even before ChatPage's own resize hook has mounted.
+const useChatSidebarWidthBootstrap = () => {
+  const { user } = useSnapshot(userStore)
+  const userId = user?.userId ?? 'default'
+
+  useEffect(() => {
+    setChatSidebarWidthCssVar(getStoredChatSidebarWidth(userId))
+  }, [userId])
+}
+
+export default useChatSidebarWidthBootstrap
