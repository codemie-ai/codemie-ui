+
+import { render, screen } from '@testing-library/react'
+import { describe, expect, it, vi } from 'vitest'
+
+import WorkflowActions from '../WorkflowActions'
+
+import type { Workflow } from '../WorkflowCard'
+
+// Real NavigationMore is intentionally NOT mocked — these tests verify production ARIA wiring.
+
+vi.mock('@/hooks/useVueRouter', () => ({
+  useVueRouter: vi.fn(() => ({ push: vi.fn() })),
+}))
+
+vi.mock('@/store/workflows', () => ({
+  workflowsStore: {
+    unpublishWorkflowFromMarketplace: vi.fn().mockResolvedValue(undefined),
+    deleteWorkflow: vi.fn().mockResolvedValue(undefined),
+  },
+}))
+
+vi.mock('@/utils/toaster', () => ({
+  default: { info: vi.fn(), error: vi.fn() },
+}))
+
+vi.mock('@/utils/utils', async (importOriginal) => {
+  const actual = await importOriginal<object>()
+  return { ...actual, copyToClipboard: vi.fn() }
+})
+
+vi.mock('../PublishWorkflowToMarketplaceModal', () => ({ default: () => null }))
+vi.mock('@/components/ConfirmationModal', () => ({ default: () => null }))
+vi.mock('../utils/getWorkflowLink', () => ({ getWorkflowLink: vi.fn(() => '/workflow/1') }))
+
+vi.mock('@/assets/icons/navigation-more.svg?react', () => ({ default: () => <svg /> }))
+vi.mock('@/assets/icons/copy-link.svg?react', () => ({ default: () => <svg /> }))
+vi.mock('@/assets/icons/copy.svg?react', () => ({ default: () => <svg /> }))
+vi.mock('@/assets/icons/delete.svg?react', () => ({ default: () => <svg /> }))
+vi.mock('@/assets/icons/edit.svg?react', () => ({ default: () => <svg /> }))
+vi.mock('@/assets/icons/info.svg?react', () => ({ default: () => <svg /> }))
+vi.mock('@/assets/icons/publish.svg?react', () => ({ default: () => <svg /> }))
+vi.mock('@/assets/icons/unpublish.svg?react', () => ({ default: () => <svg /> }))
+
+const makeWorkflow = (overrides: Partial<Workflow> = {}): Workflow => ({
+  id: '1',
+  slug: 'test-workflow',
+  name: 'Test Workflow',
+  user_abilities: ['read', 'write', 'delete'],
+  is_global: false,
+  ...overrides,
+})
+
+describe('NavigationMore accessibility — real component wiring', () => {
+  describe('Pattern A: component-local context (WorkflowActions)', () => {
+    it('exposes "More options <workflow name>" as the computed accessible name', () => {
+      render(<WorkflowActions workflow={makeWorkflow({ name: 'Alpha Workflow' })} />)
+
+      expect(
+        screen.getByRole('button', { name: 'More options Alpha Workflow' })
+      ).toBeInTheDocument()
+    })
+
+    it('wires aria-labelledby to a mounted context target; no aria-label retained', () => {
+      render(<WorkflowActions workflow={makeWorkflow({ name: 'Beta Workflow' })} />)
+
+      const trigger = screen.getByRole('button', { name: 'More options Beta Workflow' })
+
+      expect(trigger).not.toHaveAttribute('aria-label')
+
+      const labelledBy = trigger.getAttribute('aria-labelledby')!
+      const [, contextId] = labelledBy.split(/\s+/)
+      expect(document.getElementById(contextId)).toBeInTheDocument()
+    })
+
+    it('aria-labelledby token order is trigger-id first, context-id second', () => {
+      render(<WorkflowActions workflow={makeWorkflow()} />)
+
+      const trigger = screen.getByRole('button', { name: /More options/i })
+      const [triggerId, contextId] = trigger.getAttribute('aria-labelledby')!.split(/\s+/)
+
+      expect(triggerId).toBe(trigger.id)
+      expect(document.getElementById(contextId)?.textContent).toContain('Test Workflow')
+    })
+  })
+
+  describe('Pattern D: multiple concurrent contextual instances', () => {
+    it('two WorkflowActions each expose their own entity name in the accessible button name', () => {
+      render(
+        <>
+          <WorkflowActions workflow={makeWorkflow({ id: '10', name: 'First Workflow' })} />
+          <WorkflowActions workflow={makeWorkflow({ id: '20', name: 'Second Workflow' })} />
+        </>
+      )
+
+      const first = screen.getByRole('button', { name: 'More options First Workflow' })
+      const second = screen.getByRole('button', { name: 'More options Second Workflow' })
+
+      expect(first.id).not.toBe(second.id)
+      expect(first.getAttribute('aria-labelledby')).not.toBe(second.getAttribute('aria-labelledby'))
+
+      const [, firstCtxId] = first.getAttribute('aria-labelledby')!.split(/\s+/)
+      const [, secondCtxId] = second.getAttribute('aria-labelledby')!.split(/\s+/)
+
+      expect(document.getElementById(firstCtxId)?.textContent).toContain('First Workflow')
+      expect(document.getElementById(secondCtxId)?.textContent).toContain('Second Workflow')
+    })
+  })
+})
