diff --git a/src/pages/workflows/components/__tests__/WorkflowActions.accessibility.test.tsx b/src/pages/workflows/components/__tests__/WorkflowActions.accessibility.test.tsx
new file mode 100644
index 000000000..650854b8a
--- /dev/null
+++ b/src/pages/workflows/components/__tests__/WorkflowActions.accessibility.test.tsx
@@ -0,0 +1,122 @@
+// Copyright 2026 EPAM Systems, Inc. ("EPAM")
