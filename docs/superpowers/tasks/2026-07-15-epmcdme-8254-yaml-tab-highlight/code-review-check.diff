diff --git a/src/components/AceEditor/__tests__/AceEditor.test.tsx b/src/components/AceEditor/__tests__/AceEditor.test.tsx
index 4f37c6578..0e45f70ee 100644
--- a/src/components/AceEditor/__tests__/AceEditor.test.tsx
+++ b/src/components/AceEditor/__tests__/AceEditor.test.tsx
@@ -105,4 +105,20 @@ describe('AceEditor keyboard focus trap fix', () => {
       expect.objectContaining({ showInvisibles: true })
     )
   })
+
+  it('adds glyph-suppression and tab-color classes to the container when showInvisibles is true', () => {
+    const { container } = render(<AceEditor value="" showInvisibles />)
+    const editorDiv = container.querySelector('[data-name="ace_editor"]')
+
+    expect(editorDiv?.className).toContain('[&_.ace_invisible_space]:!invisible')
+    expect(editorDiv?.className).toContain('[&_.ace_invisible_eol]:!invisible')
+    expect(editorDiv?.className).toContain('[&_.ace_invisible_tab]:!text-failed-secondary')
+  })
+
+  it('does not add glyph-suppression classes to the container when showInvisibles is false (default)', () => {
+    const { container } = render(<AceEditor value="" />)
+    const editorDiv = container.querySelector('[data-name="ace_editor"]')
+
+    expect(editorDiv?.className).not.toContain('ace_invisible')
+  })
 })
