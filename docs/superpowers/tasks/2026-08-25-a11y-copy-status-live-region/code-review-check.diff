  +// live region.
  +const toAnnouncement = (text: string): string =>
  +  text
  +    .replace(/<br\s*\/?>/gi, ' ')
  +    .replace(/<[^>]+>/g, '')
  +    .replace(/\s+/g, ' ')
  +    .trim()
