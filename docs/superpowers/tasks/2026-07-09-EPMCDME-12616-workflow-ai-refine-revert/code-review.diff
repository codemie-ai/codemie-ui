+      expect(screen.getByTestId('ace-editor')).toBeInTheDocument()
+    })
+    expect(screen.getByText(/states:/)).toBeInTheDocument()
+  })
+
+  it('calls onApply with yaml when Apply Changes clicked', async () => {
