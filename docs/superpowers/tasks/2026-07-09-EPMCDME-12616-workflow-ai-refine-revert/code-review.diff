+describe('RefineWorkflowModal', () => {
+  const user = userEvent.setup()
+  const baseFields: WorkflowAIRefineFields = { yaml_config: 'states: []' }
+
+  beforeEach(() => {
+    vi.clearAllMocks()
+  })
+
+  it('shows spinner while loading', () => {
+    mockRefineWorkflowWithAI.mockReturnValue(new Promise(() => {}))
+    render(
+      <RefineWorkflowModal
+        visible={true}
+        workflowId="wf-1"
+        refineFields={baseFields}
+        onHide={vi.fn()}
+        onApply={vi.fn()}
+      />
+    )
+    expect(screen.getByRole('status')).toBeInTheDocument()
+  })
+
+  it('shows slow-request warning after 15 seconds', async () => {
+    vi.useFakeTimers()
+    mockRefineWorkflowWithAI.mockReturnValue(new Promise(() => {}))
+    render(
+      <RefineWorkflowModal
+        visible={true}
+        workflowId="wf-1"
+        refineFields={baseFields}
+        onHide={vi.fn()}
+        onApply={vi.fn()}
+      />
+    )
+    await act(async () => {
+      vi.advanceTimersByTime(15001)
+    })
+    expect(screen.getByText(/taking longer than expected/i)).toBeInTheDocument()
+    vi.useRealTimers()
+  })
+
+  it('shows YAML preview after successful refine', async () => {
+    mockRefineWorkflowWithAI.mockResolvedValueOnce({ yaml_config: 'states:\n  - id: ai' })
+    render(
+      <RefineWorkflowModal
+        visible={true}
+        workflowId="wf-1"
+        refineFields={baseFields}
+        onHide={vi.fn()}
+        onApply={vi.fn()}
+      />
