+// limitations under the License.
+//
+import { useCallback, useEffect, useRef, useState } from 'react'
+
+import AceEditor from '@/components/AceEditor/AceEditor'
+import Button from '@/components/Button'
+import Popup from '@/components/Popup'
+import Spinner from '@/components/Spinner'
+import { ButtonType } from '@/constants'
+import { workflowsStore } from '@/store/workflows'
+import { WorkflowAIRefineFields } from '@/types/entity/workflow'
+
+const SLOW_REQUEST_TIMEOUT_MS = 15_000
+const HARD_TIMEOUT_MS = 60_000
+
+interface RefineWorkflowModalProps {
+  visible: boolean
+  workflowId: string
+  refineFields: WorkflowAIRefineFields
+  onHide: () => void
+  onApply: (yaml: string) => void
+}
+
+type ModalState = 'loading' | 'result' | 'error'
+
+const RefineWorkflowModal = ({
+  visible,
+  workflowId,
+  refineFields,
+  onHide,
+  onApply,
+}: RefineWorkflowModalProps) => {
+  const [modalState, setModalState] = useState<ModalState>('loading')
+  const [resultYaml, setResultYaml] = useState('')
+  const [errorMessage, setErrorMessage] = useState('')
+  const [showSlowWarning, setShowSlowWarning] = useState(false)
+  const abortRef = useRef<AbortController | null>(null)
+
+  const runRefine = useCallback(async () => {
+    setModalState('loading')
+    setResultYaml('')
+    setErrorMessage('')
+    setShowSlowWarning(false)
+
+    const slowTimer = setTimeout(() => setShowSlowWarning(true), SLOW_REQUEST_TIMEOUT_MS)
+    const hardTimer = setTimeout(() => {
+      abortRef.current?.abort()
+      setModalState('error')
+      setErrorMessage('Request timed out. Please try again.')
+    }, HARD_TIMEOUT_MS)
+
+    try {
+      const result = await workflowsStore.refineWorkflowWithAI(workflowId, refineFields)
+      setResultYaml(result.yaml_config)
+      setModalState('result')
+    } catch (error: any) {
+      const message =
+        error?.parsedError?.error?.message ?? error?.message ?? 'Failed to refine workflow'
+      setErrorMessage(message)
+      setModalState('error')
+    } finally {
+      clearTimeout(slowTimer)
+      clearTimeout(hardTimer)
+    }
+  }, [workflowId, refineFields])
+
+  useEffect(() => {
+    if (!visible) return
+    runRefine()
+  }, [visible])
+
+  const handleHide = () => {
+    abortRef.current?.abort()
+    setModalState('loading')
+    setResultYaml('')
+    setErrorMessage('')
+    setShowSlowWarning(false)
+    onHide()
+  }
+
+  const handleApply = () => {
+    onApply(resultYaml)
+    handleHide()
+  }
+
+  return (
+    <Popup
+      visible={visible}
+      onHide={handleHide}
+      className="max-w-4xl w-full"
+      overlayClassName="z-60"
+      header="Refine Workflow with AI"
+      hideFooter={modalState !== 'result'}
+      footer={
+        modalState === 'result' ? (
+          <div className="flex gap-4 justify-end">
+            <Button variant={ButtonType.SECONDARY} onClick={handleHide}>
+              Close
+            </Button>
+            <Button onClick={handleApply}>Apply Changes</Button>
+          </div>
+        ) : undefined
+      }
+    >
+      <div className="max-h-[calc(90vh-200px)] overflow-y-auto">
+        {modalState === 'loading' && (
+          <div className="flex flex-col items-center gap-4 py-8">
+            <Spinner />
+            <p className="text-text-quaternary">Analyzing your Workflow configuration…</p>
+            {showSlowWarning && (
+              <p className="text-text-quaternary text-sm">
+                This is taking longer than expected. Please wait…
+              </p>
+            )}
+          </div>
+        )}
+
+        {modalState === 'result' && (
+          <AceEditor value={resultYaml} readonly name="refine_workflow_preview" />
+        )}
+
+        {modalState === 'error' && (
+          <div className="flex flex-col items-center gap-4 py-8">
+            <p className="text-status-error">{errorMessage}</p>
+            <Button variant={ButtonType.SECONDARY} onClick={runRefine}>
+              Try Again
+            </Button>
+          </div>
+        )}
+      </div>
+    </Popup>
+  )
+}
+
+export default RefineWorkflowModal
+```
