+    expect(screen.queryByText('Refine Workflow with AI')).not.toBeInTheDocument()
+  })
+
+  it('calls onRefine with empty string when submitted without a prompt', async () => {
+    const onRefine = vi.fn()
+    render(<RefineWorkflowPromptPopup isVisible={true} onHide={vi.fn()} onRefine={onRefine} />)
+    await user.click(screen.getByText('Refine with AI'))
+    await waitFor(() => {
+      expect(onRefine).toHaveBeenCalledWith('')
+    })
+  })
+
+  it('calls onRefine with the entered prompt', async () => {
+    const onRefine = vi.fn()
+    render(<RefineWorkflowPromptPopup isVisible={true} onHide={vi.fn()} onRefine={onRefine} />)
