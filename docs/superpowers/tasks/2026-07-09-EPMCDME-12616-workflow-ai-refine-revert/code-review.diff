+    render(
+      <RefineWorkflowModal
+        visible={true}
+        workflowId="wf-1"
+        refineFields={baseFields}
+        onHide={vi.fn()}
+        onApply={onApply}
+      />
+    )
+    await waitFor(() => screen.getByText('Apply Changes'))
+    await user.click(screen.getByText('Apply Changes'))
+    expect(onApply).toHaveBeenCalledWith('states:\n  - id: ai')
+  })
+
+  it('shows error message and Try Again button on failure', async () => {
+    const errorPayload = { parsedError: { error: { message: 'LLM quota exceeded' } } }
+    mockRefineWorkflowWithAI.mockRejectedValueOnce(errorPayload)
+    render(
+      <RefineWorkflowModal
+        visible={true}
+        workflowId="wf-1"
+        refineFields={baseFields}
+        onHide={vi.fn()}
+        onApply={vi.fn()}
+      />
+    )
+    await waitFor(() => {
+      expect(screen.getByText('LLM quota exceeded')).toBeInTheDocument()
+    })
+    expect(screen.getByText('Try Again')).toBeInTheDocument()
+  })
+
+  it('retries on Try Again click', async () => {
+    const errorPayload = { parsedError: { error: { message: 'LLM quota exceeded' } } }
+    mockRefineWorkflowWithAI
+      .mockRejectedValueOnce(errorPayload)
+      .mockResolvedValueOnce({ yaml_config: 'states: []' })
+
+    render(
+      <RefineWorkflowModal
+        visible={true}
+        workflowId="wf-1"
+        refineFields={baseFields}
+        onHide={vi.fn()}
+        onApply={vi.fn()}
+      />
+    )
+    await waitFor(() => screen.getByText('Try Again'))
+    await user.click(screen.getByText('Try Again'))
+    await waitFor(() => {
+      expect(screen.getByTestId('ace-editor')).toBeInTheDocument()
+    })
+    expect(mockRefineWorkflowWithAI).toHaveBeenCalledTimes(2)
+  })
+})
