+
+  if (all.length < first.total) {
+    console.warn(
+      `Project display-name search only scanned ${all.length} of ${first.total} projects (page cap reached)`
+    )
+  }
+
+  return all
+}
+
+const sortProjectsClientSide = (
+  projects: Project[],
+  sortBy?: string,
+  sortOrder?: string
