+    expect(mockGet).toHaveBeenCalledTimes(1)
+    expect(projectDisplayNamesStore.cache['proj-d']).toBe('Project Delta')
+  })
+
+  it('ignores an empty project name', async () => {
+    await projectDisplayNamesStore.ensure('')
