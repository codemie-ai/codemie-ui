+    expect(mockGet).toHaveBeenCalledTimes(1)
+  })
+
+  it('deduplicates concurrent lookups of the same project', async () => {
+    mockGet.mockResolvedValue(jsonResponse({ name: 'proj-d', display_name: 'Project Delta' }))
