+        assistantIds: [],
+        assistantData: [],
+        history: [],
+      }
+
+      await chatsStore.exportChat('docx')
+
+      expect(downloadSpy).toHaveBeenCalledWith(
+        'v1/conversations/chat-123/export?export_format=docx',
+        undefined,
+        'Sprint 39 Release Notes.docx'
