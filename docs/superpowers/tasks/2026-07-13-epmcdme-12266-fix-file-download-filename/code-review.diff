+  if (!sortBy) return projects
+
+  const direction = sortOrder === 'desc' ? -1 : 1
+  return [...projects].sort((a, b) => {
+    const aValue = String((a as any)[sortBy] ?? '')
+    const bValue = String((b as any)[sortBy] ?? '')
+    return aValue.localeCompare(bValue) * direction
+  })
