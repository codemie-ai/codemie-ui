+export function getProjectDisplayName(project: { name: string; display_name?: string | null }): string {
+  return project.display_name?.trim() || project.name
+}
+
+export function generateProjectName(displayName: string): string {
+  return displayName
+    .toLowerCase()
+    .replace(/\s+/g, '-')
+    .replace(/[^a-z0-9_-]/g, '')
+    .replace(/-+/g, '-')
+    .replace(/(^-|-$)/g, '')
+}
