+import { act, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import MultiSelect from '../MultiSelect'
+
+describe('MultiSelect filterBy regression guard (EPMCDME-13637)', () => {
+  afterEach(() => {
+    vi.useRealTimers()
+    vi.clearAllMocks()
+  })
+
+  it('option whose value (technical name) matches filter query remains visible when displayName does not match', async () => {
+    // PrimeReact uses setTimeout(fn, 0) to update filterState (debounce with 0ms delay).
+    // Fake timers + runAllTimers() advances past it so the filter re-render happens synchronously.
+    vi.useFakeTimers()
+
+    const options = [
+      { value: 'proj-tech-abc', label: 'Project Alpha', displayName: 'Friendly Alpha Display' },
+      { value: 'proj-tech-xyz', label: 'Project Beta', displayName: 'Friendly Beta Display' },
+    ]
+
+    render(
+      <MultiSelect
+        options={options}
+        value={[]}
+        onChange={vi.fn()}
+        onFilter={vi.fn()}
+        filterBy="value,displayName"
+      />
+    )
+
+    // Let initial render effects settle
+    await act(async () => {
+      vi.runAllTimers()
+    })
+
+    // Open the dropdown panel
+    act(() => {
+      fireEvent.click(document.querySelector('[data-pc-name="multiselect"]')!)
+    })
+    await act(async () => {
+      vi.runAllTimers()
+    })
+
+    // Type the technical name — matches option.value='proj-tech-abc' but NOT any label or displayName
+    const filterInput = screen.getByPlaceholderText('Search')
+    act(() => {
+      fireEvent.change(filterInput, { target: { value: 'proj-tech-abc' } })
+    })
+    // Advance past PrimeReact's 0ms debounce to trigger filterState update and re-render
+    await act(async () => {
+      vi.runAllTimers()
+    })
+
+    // Option with matching value field must remain visible in the rendered dropdown
+    expect(screen.getByText('Project Alpha')).toBeInTheDocument()
+
+    // Option with no matching field must not be rendered
+    expect(screen.queryByText('Project Beta')).not.toBeInTheDocument()
+  })
+})
