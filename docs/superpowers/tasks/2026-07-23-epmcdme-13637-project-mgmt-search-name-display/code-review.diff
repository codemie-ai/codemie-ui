+// limitations under the License.
+
+import { render, screen } from '@testing-library/react'
+import { describe, it, expect } from 'vitest'
+
+import ProjectNameDisplay from '../ProjectNameDisplay'
+
+describe('ProjectNameDisplay', () => {
+  it('renders just the name when displayName is not provided', () => {
+    render(<ProjectNameDisplay name="epm-fdeg" />)
+    expect(screen.getByText('epm-fdeg')).toBeTruthy()
+    expect(screen.queryByText('FDE Group')).toBeNull()
+  })
+
+  it('renders just the name when displayName is null', () => {
+    render(<ProjectNameDisplay name="epm-fdeg" displayName={null} />)
+    expect(screen.getByText('epm-fdeg')).toBeTruthy()
+  })
+
+  it('renders just the name when displayName is an empty string', () => {
+    const { container } = render(<ProjectNameDisplay name="epm-fdeg" displayName="" />)
+    expect(screen.getByText('epm-fdeg')).toBeTruthy()
+    expect(container.querySelectorAll('span')).toHaveLength(0)
+  })
+
+  it('renders just the name when displayName is whitespace only', () => {
+    render(<ProjectNameDisplay name="epm-fdeg" displayName="   " />)
+    expect(screen.getByText('epm-fdeg')).toBeTruthy()
+  })
+
+  it('renders both name and displayName in a stacked layout', () => {
+    render(<ProjectNameDisplay name="epm-fdeg" displayName="FDE Group" />)
+    expect(screen.getByText('epm-fdeg')).toBeTruthy()
+    expect(screen.getByText('FDE Group')).toBeTruthy()
+  })
+
+  it('trims whitespace from displayName before rendering', () => {
+    render(<ProjectNameDisplay name="epm-fdeg" displayName="  FDE Group  " />)
+    expect(screen.getByText('FDE Group')).toBeTruthy()
+  })
+
+  it('does not render data-tooltip-id or data-tooltip-content attributes', () => {
+    const { container } = render(<ProjectNameDisplay name="epm-fdeg" displayName="FDE Group" />)
+    expect(container.querySelector('[data-tooltip-id]')).toBeNull()
+    expect(container.querySelector('[data-tooltip-content]')).toBeNull()
+  })
+
+  it('applies truncate class when truncate prop is true', () => {
+    const { container } = render(
+      <ProjectNameDisplay name="epm-fdeg" displayName="FDE Group" truncate />
+    )
+    const displayNameSpan = container.querySelector('.truncate')
+    expect(displayNameSpan).toBeTruthy()
+    expect(displayNameSpan?.textContent).toBe('FDE Group')
+  })
+
+  it('does not apply truncate class when truncate prop is false', () => {
+    const { container } = render(
+      <ProjectNameDisplay name="epm-fdeg" displayName="FDE Group" truncate={false} />
+    )
+    expect(container.querySelector('.truncate')).toBeNull()
+  })
+})
