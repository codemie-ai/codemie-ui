+/**
+ * When the model is not (yet) in the store — either because `getLLMModels()`
+ * has not resolved, or because it failed and left the store empty — fall back
+ * to a name-based check on the raw `modelValue`. This preserves the Claude
+ * cap on the EditAssistant path where `llm_model_type` arrives from server
+ * defaults before `LLMSelector` finishes loading the model list, and on the
+ * fetch-failure path where the store stays empty for the rest of the session.
+ * Non-Claude names keep the standard cap.
+ */
+function looksLikeClaudeByName(modelValue: string): boolean {
+  return modelValue.toLowerCase().includes('claude')
+}
+
 export function getTemperatureMax(modelValue: string | undefined): number {
   if (!modelValue) return VALIDATION_CONSTRAINTS.TEMPERATURE_MAX_STANDARD
   const model = appInfoStore.llmModels.find((m) => m.value === modelValue)
-  return isClaudeOnAnthropicProvider(model)
+  if (model) {
+    return isClaudeOnAnthropicProvider(model)
+      ? VALIDATION_CONSTRAINTS.TEMPERATURE_MAX_CLAUDE
+      : VALIDATION_CONSTRAINTS.TEMPERATURE_MAX_STANDARD
+  }
+  return looksLikeClaudeByName(modelValue)
     ? VALIDATION_CONSTRAINTS.TEMPERATURE_MAX_CLAUDE
     : VALIDATION_CONSTRAINTS.TEMPERATURE_MAX_STANDARD
 }
