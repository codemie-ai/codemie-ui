diff --git a/src/components/Navigation/__tests__/NavigationExpandButton.test.tsx b/src/components/Navigation/__tests__/NavigationExpandButton.test.tsx
index 2a5a2f055..d3645c25a 100644
--- a/src/components/Navigation/__tests__/NavigationExpandButton.test.tsx
