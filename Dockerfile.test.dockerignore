# Ignore rules for Dockerfile.test only (BuildKit per-Dockerfile ignore).
# Unlike the main .dockerignore, the tracked .env is deliberately NOT ignored:
# it holds only non-secret VITE_* vars and must be present so `vite build`
# bakes the same values the dev server serves. Personal env overrides must
# stay out of the build context and bundle:
.env.local
.env.*.local
node_modules
dist_keycloak
dist
.git
test_screenshots
core.*
